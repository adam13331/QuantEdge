generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id             String      @id
  name           String
  platform       String
  initialBalance Float
  currency       String      @default("USD")
  createdAt      DateTime    @default(now())
  trades         Trade[]
  plans          TradePlan[]
  ledger         PropLedgerEntry[]
}

model Trade {
  id           String     @id
  date         String
  symbol       String
  underlying   String
  type         String
  direction    String
  optionType   String?
  strike       Float?
  expiry       String?
  quantity     Float
  entryPrice   Float
  exitPrice    Float
  commission   Float
  fees         Float
  pnl          Float
  status       String
  entryTime    String?
  exitTime     String?
  rr           String?
  plannedRisk  Float?    // dollars at risk when the position was opened (from DEAL_SL)
  durationMin  Float?    // exact hold time from MetaTrader, minutes
  mae          Float?
  mfe          Float?
  exitReason   String?   // stop-loss | take-profit | manual | expert | ... (from DEAL_REASON)
  magic        Int?      // EA magic number; 0 means placed by hand
  legs         Int?      // number of entry deals (1 = a single entry)
  averagedDown Boolean?  // a later entry was at a worse price than the first
  balanceAfter Float?    // account balance once this position closed
  hourOfDay    Int?
  atr          Float?     // ATR(14) on the exporter's chart timeframe at entry
  spread       Float?     // spread at entry, price units
  dayRange     Float?     // high-low of the session before entry
  playbookId   String?
  setupVersion Int?       // playbook revision live when the trade was taken
  planId       String?
  tags         String     @default("[]")
  mistakeTags  String     @default("[]") // review: what went wrong, from a fixed vocabulary
  followedPlan Boolean?   // review: null = not reviewed yet
  confidence   Int?       // 1-5, recorded at entry
  isForwardTest Boolean   @default(false) // taken after an experiment started
  journalEntry String?
  link         String?
  imageUrls    String     @default("[]")
  accountId    String?
  account      Account?   @relation(fields: [accountId], references: [id])
  plan         TradePlan?
  createdAt    DateTime   @default(now())
}

model TradePlan {
  id           String   @id
  date         String
  symbol       String
  underlying   String
  direction    String
  setupType    String?
  thesis       String?
  entryZone    String?
  stopLevel    Float?
  targetLevel  Float?
  plannedRR    String?
  plannedSize  Float?
  invalidation String?
  status       String   @default("pending")
  tradeId      String?  @unique
  trade        Trade?   @relation(fields: [tradeId], references: [id])
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])
  createdAt    DateTime @default(now())
}

model Playbook {
  id            String   @id
  name          String
  description   String?
  rules         String   @default("[]")
  timeframes    String?
  instruments   String?
  entryTriggers String   @default("[]")
  exitRules     String?
  notes         String?
  imageUrls      String   @default("[]")
  revisions     String   @default("[]") // [{ version, effectiveDate, summary, createdAt }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A written hypothesis with a date range. Performance before and after are
// computed from the trades themselves, so an experiment is only a claim plus
// the boundary that makes it testable.
model Experiment {
  id             String   @id
  name           String
  hypothesis     String
  change         String
  expectedEffect String?
  startDate      String
  endDate        String?
  playbookId     String?
  status         String   @default("running") // running | concluded | abandoned
  conclusion     String?
  createdAt      DateTime @default(now())
}

model JournalTemplate {
  id        String   @id
  name      String
  content   String
  scope     String   @default("all")
  createdAt DateTime @default(now())
}

model Tag {
  id   String @id
  name String @unique
}

// The cash history of a prop challenge: what the evaluation cost and what it
// paid back. Deliberately separate from the challenge rule config — the rules
// are a plan the trader can edit freely, these rows are money that moved.
// `amount` is signed (fees negative, payouts positive) so one sum is the net;
// the API route writes the sign so the form can always ask for a positive.
model PropLedgerEntry {
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String   // "fee" | "payout"
  date      String   // YYYY-MM-DD, same convention as Trade.date
  amount    Float
  // The firm the entry was paid to or by, captured at save time. The challenge
  // preset lives in localStorage and can be switched, so without this an old
  // fee would silently start reporting against a new firm.
  firm      String?
  label     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([accountId, date])
}
